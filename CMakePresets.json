{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_CXX_COMPILER": "clang++",
        "CMAKE_CXX_STANDARD": "23",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF"
      }
    },
    {
      "name": "debug",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "release",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "sanitize",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "kpi",
      "inherits": "release",
      "cacheVariables": {
        "MODERN_RUNTIME_BUILD_KPI": "ON"
      }
    },
    {
      "name": "kpi-sanitize",
      "inherits": "sanitize",
      "cacheVariables": {
        "MODERN_RUNTIME_BUILD_KPI": "ON"
      }
    },
    {
      "name": "kpi-sbo32",
      "inherits": "kpi",
      "cacheVariables": {
        "MODERN_RUNTIME_INLINE_CALLABLE_BYTES": "32"
      }
    },
    {
      "name": "kpi-sbo48",
      "inherits": "kpi",
      "cacheVariables": {
        "MODERN_RUNTIME_INLINE_CALLABLE_BYTES": "48"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug"
    },
    {
      "name": "release",
      "configurePreset": "release"
    },
    {
      "name": "sanitize",
      "configurePreset": "sanitize"
    },
    {
      "name": "kpi",
      "configurePreset": "kpi"
    },
    {
      "name": "kpi-sanitize",
      "configurePreset": "kpi-sanitize"
    },
    {
      "name": "kpi-sbo32",
      "configurePreset": "kpi-sbo32"
    },
    {
      "name": "kpi-sbo48",
      "configurePreset": "kpi-sbo48"
    }
  ]
}
